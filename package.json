{
  "name": "dsh-supervision",
  "version": "0.0.0",
  "description": "Cordis plugin: expose a running DeepSeek Harness web session to herdr-core through the dsh-sup forwarder",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client/**",
    "icon.svg",
    "locale",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm --filter dsh-supervision-protocol build && tsc -p tsconfig.json && rm -rf lib && tsdown && node scripts/build-client.mjs && tsc -p tsconfig.client.json",
    "test": "pnpm build && node --test 'lib/*.test.js' 'lib/client/*.test.js' && node --test scripts/release.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:validate": "node scripts/validate-release-version.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "dsh-supervision-protocol": "workspace:*",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.2"
  },
  "dependencies": {}
}
