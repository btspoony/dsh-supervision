{
  "name": "dsh-supervision",
  "version": "0.1.0-alpha.1",
  "description": "Cordis plugin: bridge a running DeepSeek Harness web session to any terminal supervisor that reads OSC 7501",
  "keywords": [
    "dsh",
    "dsh-plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btspoony/dsh-supervision.git"
  },
  "homepage": "https://github.com/btspoony/dsh-supervision#readme",
  "bugs": {
    "url": "https://github.com/btspoony/dsh-supervision/issues"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.2-rc.1"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client/**",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "docs",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm --filter dsh-supervision-protocol build && tsc -p tsconfig.json && rm -rf lib && tsdown && node scripts/build-client.mjs && tsc -p tsconfig.client.json",
    "test": "pnpm build && node --test 'lib/*.test.js' 'lib/client/*.test.js' && node --test scripts/release.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:validate": "node scripts/validate-release-version.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "dsh-supervision-protocol": "workspace:*",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.2"
  },
  "dependencies": {}
}
